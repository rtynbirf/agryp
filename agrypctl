#!/bin/sh
# agrypctl — руки для agryp: команда = файл-договор (Ст. 13, Виток 5, школа s6).
# Никаких сокетов и FIFO: stop кладёт <dir>/.agryp-ctl/<unit>.down — супервизор
# казнит попытку (TERM группе) и замораживает политику перезапуска, пока файл
# жив; start снимает файл — ctl-up и новая попытка с чистой лестницей.
# Статус не дублируем: читаем тот же файл семьи, что и `agryp status` (Ст. 13).
# card (волна ×6, П37): A2A AgentCard из ЖИВОГО супервизора — тот же
# строитель, что tools/agentcard.py; карта валидируется схемой до выдачи.
#
# usage: agrypctl [--dir DIR] stop <unit> | start <unit> | status [--card] | metrics | card
# (--dir принимается до или после команды: `agrypctl card --dir X` ≡ `agrypctl --dir X card`)

set -u

dir=examples
card=no
cmd=
unit=
prev=
for a in "$@"; do
    case "$prev" in
        # --dir съедает только своё значение, а не следующую команду
        # (независимый аудит 2026-11-10: `agrypctl --dir DIR stop unit`
        # превращал DIR в команду — demo-ctl красный на чистой машине)
        --dir) dir=$a; prev=; continue ;;
    esac
    case "$a" in
        --dir) prev=--dir ;;
        --card) card=yes ;;
        *)
            if [ -z "$cmd" ]; then cmd=$a
            elif [ -z "$unit" ] && { [ "$cmd" = stop ] || [ "$cmd" = start ]; }; then unit=$a
            fi
            prev=
            ;;
    esac
done

case "$cmd" in
    stop|start)
        [ -n "$unit" ] || { echo "agrypctl: $cmd требует имя юнита" >&2; exit 2; }
        ;;
    status|metrics|card) ;;
    *)
        echo "usage: agrypctl [--dir DIR] stop <unit> | start <unit> | status [--card] | metrics | card" >&2
        exit 2
        ;;
esac

ctl="$dir/.agryp-ctl"

case "$cmd" in
    stop)
        [ -f "$dir/$unit.agent" ] \
            || { echo "agrypctl: нет юнита $dir/$unit.agent" >&2; exit 2; }
        mkdir -p "$ctl"
        # атомарность по Ст. 13: tmp + rename — супервизор не видит полфайла
        tmp="$ctl/.tmp.$$"
        : > "$tmp" && mv "$tmp" "$ctl/$unit.down"
        echo "agrypctl: $unit.down положен — попытка будет казнена, политика заморожена"
        ;;
    start)
        if [ -f "$ctl/$unit.down" ]; then
            rm "$ctl/$unit.down"
            echo "agrypctl: $unit.down снят — новая попытка пойдёт в ближайшей итерации"
        else
            echo "agrypctl: $ctl/$unit.down не существует — юнит живёт по своей политике"
        fi
        ;;
    status|card)
        [ -x ./agryp ] || { echo "agrypctl: соберите ядро: make" >&2; exit 2; }
        if [ "$card" = yes ] || [ "$cmd" = card ]; then
            # П37 (волна ×6): карта жива или её нет — третий вариант не выдаётся
            exec python3 "$(dirname "$0")/tools/agentcard.py" build --dir "$dir"
        fi
        exec ./agryp status --dir "$dir"
        ;;
    metrics)
        # Виток 10: метрики — тот же файл-договор .agryp-metrics.prom, не второй источник
        [ -x ./agryp ] || { echo "agrypctl: соберите ядро: make" >&2; exit 2; }
        exec ./agryp metrics --dir "$dir"
        ;;
esac
