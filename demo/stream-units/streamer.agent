# Виток 7, тикет 009: жгу без пауз — квант 500 токенов каждые 25 мс
# (20k/с); после каждой записи — рапорт в файл + SIGUSR2 супервизору
# (AGRY_SUPER_PID): будильник вместо тика 250 мс. Бюджет 5000 — линия
# на 10-м кванте, казнь обязана прийти на первом пробуждении после неё.
name         = streamer
exec         = . demo/stream_worker.sh
restart      = no
token-budget = 5000
