{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/rtynbirf/agryp/main/schemas/a2a-agentcard.schema.json",
  "title": "A2A AgentCard — agryp (П37)",
  "description": "Карта агента для agrypctl status по мотивам A2A v1.0 Signed Agent Cards. Транспорт agryp — файл вместо сокета (Ст. 13), поэтому url/endpoints — file:// URI живых артефактов супервизора; расширенные поля помечены префиксом x-agryp. Валидатор — std-only (tools/agentcard.py, подмножество draft-07).",
  "type": "object",
  "required": [
    "type",
    "protocolVersion",
    "name",
    "description",
    "version",
    "url",
    "capabilities",
    "defaultInputModes",
    "defaultOutputModes",
    "skills",
    "provider",
    "x-agryp"
  ],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "AgentCard" },
    "protocolVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^file://|https?://" },
    "preferredTransport": { "type": "string" },
    "capabilities": {
      "type": "object",
      "required": ["streaming", "pushNotifications", "stateTransitionHistory"],
      "additionalProperties": false,
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "stateTransitionHistory": { "type": "boolean" }
      }
    },
    "defaultInputModes": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultOutputModes": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["organization", "url"],
      "additionalProperties": false,
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "x-agryp": {
      "type": "object",
      "required": ["identity", "endpoints", "security"],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "object",
          "required": ["sup", "pid", "uptime_ms", "cell_dir"],
          "additionalProperties": false,
          "properties": {
            "sup": { "const": "agryp" },
            "pid": { "type": "integer", "minimum": 1 },
            "uptime_ms": { "type": "integer", "minimum": 0 },
            "cell_dir": { "type": "string", "minLength": 1 }
          }
        },
        "endpoints": {
          "type": "object",
          "required": ["status", "metrics", "ctl"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "metrics": { "type": "string", "pattern": "^file://" },
            "journal": { "type": "string", "pattern": "^file://" },
            "ctl": { "type": "string", "minLength": 1 }
          }
        },
        "security": { "type": "string", "minLength": 1 }
      }
    }
  }
}
